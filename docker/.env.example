# Host paths. Do not put tokens or credentials in this file.
VFLASH_HOST_ARTIFACT=/absolute/path/to/h3-runtime-ref2va-turbo4-sm89-bf16-residual-v1
VFLASH_HOST_SCHEDULE=/absolute/path/to/schedule-overlay-ref2va-turbo4-sm89-v1
VFLASH_HOST_AUXILIARY=/absolute/path/to/h3-runtime-auxiliary-v1.safetensors
VFLASH_HOST_BUNDLES=/absolute/path/to/conditioning-bundles
VFLASH_HOST_OUTPUTS=/absolute/path/to/vflash-outputs

# Select the host GPU by nvidia-smi index or GPU UUID.
VFLASH_IMAGE=vflash:0.1.0a4
VFLASH_PROFILE_ID=ref2va-turbo4-exact-sm89
VFLASH_GPU_DEVICE=0
VFLASH_API_PORT=8000
VFLASH_JOB_TIMEOUT_SECONDS=1800
VFLASH_MAX_PENDING_JOBS=8
VFLASH_JOB_HISTORY_LIMIT=128

# Optional: combine compose.yaml with compose.parallel.yaml for two SM86 GPUs.
# VFLASH_PEER_GPU_DEVICE=1
# VFLASH_PARALLEL_STRATEGY=sequence-head
